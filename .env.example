# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
WEB_PORT=3000
WEB_NODE_ENV=development

# API
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_NAME=fontbox_session
REFRESH_COOKIE_NAME=fontbox_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Storage
STORAGE_DRIVER=local
STORAGE_DIR=storage

# Amazon S3 (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# JWT
JWT_ACCESS_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=also-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Database
POSTGRES_DB=fontbox
POSTGRES_USER=fontbox
POSTGRES_PASSWORD=fontbox
DATABASE_URL=postgresql://fontbox:fontbox@localhost:5432/fontbox?schema=public

# Redis
REDIS_URL=redis://localhost:6379
