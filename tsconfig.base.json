{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": false,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@fontbox/config": ["packages/config/src/index.ts"],
      "@fontbox/config/*": ["packages/config/src/*"],
      "@fontbox/ui": ["packages/ui/src/index.ts"],
      "@fontbox/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": [],
  "exclude": ["node_modules", "dist", "build"]
}
